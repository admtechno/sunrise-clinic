# Module 9, Session 14: the settings the API needs on a server.
# On a host there is no .env file: you type each value into the host's
# environment settings (Session 17). Values in <...> are yours to make;
# never commit real ones.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<a long random value: see Session 16>
DJANGO_ALLOWED_HOSTS=<the API's host name, for example sunrise-api.example.com>
DJANGO_CORS_ORIGINS=<the web app's address, for example https://sunrise-desk.example.com>
# Session 16: the database as one address, from the database host (Neon: the
# Connect button). In the password, write / : # ? @ as %2F %3A %23 %3F %40.
DATABASE_URL=postgresql://<user>:<password>@<host>/<name>?sslmode=require
DB_CONN_MAX_AGE=60
# HTTPS is on unless you switch it off for a preview on your own PC
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# gunicorn (gunicorn.conf.py)
WEB_CONCURRENCY=2
