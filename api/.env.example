# Copy this file to .env and fill in your own values. Never commit .env to Git.
DJANGO_SECRET_KEY=<made by python new_secret_key.py>
CLINIC_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=m9_s20
DB_USER=clinic_app
DB_PASSWORD=<your clinic_app password>
DB_HOST=127.0.0.1
DB_PORT=5432
# Which pages (origins) may read the API from a browser. A comma-separated list, no slash at the end.
DJANGO_CORS_ORIGINS=http://localhost:5173
