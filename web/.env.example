# Session 14: the names the web app reads, one file per mode.
#   .env.development  npm run dev        (Vite passes /api to 127.0.0.1:8000)
#   .env.test         Vitest             (a made-up address that MSW answers)
#   .env.production   npm run build      (baked into dist: public values only)
# A .env.local file overrides them on your PC and is never committed.
VITE_API_BASE_URL=/api/v1
